{
  "name": "@jamiefutch/pi-hermes-memory-cleanup",
  "version": "0.1.5",
  "description": "Pi package: utility for cleaning up and optimizing Hermes persistent memory storage used by the Pi coding agent.",
  "type": "module",
  "keywords": [
    "pi",
    "pi-package"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamiefutch/pi-hermes-memory-cleanup.git"
  },
  "homepage": "https://github.com/jamiefutch/pi-hermes-memory-cleanup#readme",
  "bugs": {
    "url": "https://github.com/jamiefutch/pi-hermes-memory-cleanup/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "extensions",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "start": "tsx src/cli.ts",
    "report": "tsx src/cli.ts report",
    "prune": "tsx src/cli.ts prune",
    "dedupe": "tsx src/cli.ts dedupe",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.11",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
